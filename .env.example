# PolicyDesk model credentials and knowledge-base settings.
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-large
KB_NAME=policydesk_uploads_v1
MONGO_DB=policydesk
# Full path of mineru in MinerU's own environment, e.g. /opt/anaconda3/envs/mineru/bin/mineru
MINERU_COMMAND=mineru
# Vision model that turns PDF figures into searchable text.
VL_MODEL=qwen3-vl-plus
